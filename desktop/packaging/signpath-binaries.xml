      <authenticode-sign />
    </pe-file>
    <pe-file path="_internal/native-camera/NoSubCameraSetup.exe" product-name="NoSub Studio" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
